# Backend API base (server-to-server in dev rewrites). Leave http://localhost:4000 in dev.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# WhatsApp chat button — phone in international format, no '+', no spaces.
# Example: 919812345678 for an Indian number +91 98123 45678.
# LEAVE EMPTY until you have the real WhatsApp Business number — the button
# hides itself rather than linking somewhere dead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: pre-filled message text shown when the WhatsApp chat opens.
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi Finvoq team! I'd like to know more about investing through your platform.

# Public origin of this site, used for canonical / OG metadata in production.
NEXT_PUBLIC_SITE_URL=https://finvoq.com
