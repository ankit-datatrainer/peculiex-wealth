# Backend API base (server-to-server in dev rewrites). Leave http://localhost:4000 in dev.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# WhatsApp number/message are hardcoded in lib/siteFacts.ts (WHATSAPP_NUMBER),
# not read from env — a stale env value on the VPS previously caused the live
# WhatsApp links to point at an old placeholder number. No env vars here.

# Public origin of this site, used for canonical / OG metadata in production.
NEXT_PUBLIC_SITE_URL=https://finvoq.com
